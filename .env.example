# Copier vers mediatracker.env (non versionné).
# SECRET_KEY : python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_PASSWORD vide : l'assistant de premier démarrage crée le compte.

SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Jeton exigé pour créer le premier compte dans l'assistant. Si vide et aucun compte : généré au démarrage (journaux WARNING).
# SETUP_TOKEN=

# Optionnel. Sinon, saisi dans l'assistant (chiffré ensuite, plus jamais affiché).
ALLDEBRID_API_KEY=

PORT=8080
# /config : base, journaux, session aria2, sauvegardes. /data : médias et téléchargements.
CONFIG_DIR=/config
DATA_DIR=/data
DATABASE_URL=sqlite:////config/app.db
TZ=Europe/Paris
PUID=1000
PGID=100
UMASK=022

DEFAULT_QUALITY=HD
DEFAULT_LANGUAGE=VFF
HOSTER_PREFERENCE=rapidgator,turbobit,uploady,dailyuploads,1fichier
MAX_CONCURRENT_DOWNLOADS=2
# Scan des sources : 720 min = 12 h. Séries suivies encore en cours seulement.
SCAN_INTERVAL_MIN=720
SOURCE_REQUEST_DELAY_SECONDS=5
SOURCE_ERROR_BACKOFF_MIN=180
SCAN_ONGOING_ONLY=true
SCAN_AIR_WINDOW_DAYS=3
ALLOW_FALLBACK=false
QUALITY_FALLBACK=HD,1080p,HDLight
LANGUAGE_FALLBACK=VFF,MULTI,VF
SOURCE_CACHE_SECONDS=900
# Nouveautés (films et séries). 12 h = deux fois par jour. Filtre HD / VFF, conservation 60 jours.
CATALOG_INTERVAL_HOURS=12
CATALOG_RETENTION_DAYS=60
CATALOG_QUALITY=HD
CATALOG_LANGUAGE=VFF
AUTO_DELETE_DAYS=14
AUTO_DELETE_ENABLED=false
CLEANUP_NOTICE_HOURS=24
TRASH_RETENTION_DAYS=7
# Pause des téléchargements sous ce nombre de Go libres. 0 désactive.
DISK_MIN_FREE_GB=5
# Copies quotidiennes de la base dans /config/backups.
BACKUP_KEEP=7
# Journaux rotatifs sous /config/logs (octets et nombre de fichiers).
# LOG_MAX_BYTES=2000000
# LOG_BACKUP_COUNT=5
# VACUUM/ANALYZE SQLite : une fois par semaine à cette heure locale (fuseau NOTIFY_TIMEZONE).
# SQLITE_MAINTENANCE_HOUR=4
# URL publique de MediaTracker (http ou https, sans chemin). Notifications, webhook Jellyfin affiché, CORS.
# PUBLIC_URL=https://mediatracker.example.com
NOTIFY_GROUP_SECONDS=120
# Heures calmes optionnelles, HH:MM dans NOTIFY_TIMEZONE. Vides : pas de pause.
# NOTIFY_QUIET_START=22:00
# NOTIFY_QUIET_END=08:00
NOTIFY_TIMEZONE=Europe/Paris

# Verrouillage après 5 échecs de connexion : 900 secondes (15 min).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_SECONDS=900
# Attribut Secure sur les cookies de session et CSRF : true, false ou auto (défaut).
# auto : Secure seulement si la requête est en HTTPS (schéma via X-Forwarded-Proto si proxy de confiance).
# HTTP direct sur le LAN : laisser auto ou mettre false. Derrière un reverse proxy HTTPS : auto ou true.
# COOKIE_SECURE=auto
# Adresses du proxy autorisées à renseigner X-Forwarded-* (uvicorn). Ne pas mettre * sans réfléchir.
FORWARDED_ALLOW_IPS=127.0.0.1

# Générés au premier démarrage s'ils sont absents. Ne pas les journaliser.
# ARIA2_RPC_SECRET=
# JELLYFIN_WEBHOOK_SECRET=

# Compose NAS figé (ne pas y ajouter de clé API, de jeton TMDB ni de mot de passe) :
# PUID=1000
# PGID=100
# TZ=Europe/Paris
# PUBLIC_URL=https://mediatracker.example.com
# JELLYFIN_URL=http://jellyfin:8096
# MOVIES_DIR=/data/Films
# SERIES_DIR=/data/Séries
# DOWNLOADS_DIR=/data/.mediatracker/downloads
# TRASH_DIR=/data/.mediatracker/trash
# JELLYFIN_PATH_MAP=/data/movies=/data/Films;/data/tvshows=/data/Séries
# JELLYFIN_API_KEY, TMDB_READ_TOKEN et ALLDEBRID_API_KEY restent dans l'assistant.
#
# Sans MOVIES_DIR / SERIES_DIR / DOWNLOADS_DIR / TRASH_DIR, et si DATA_DIR=/data :
#   films /data/media/Films, séries /data/media/Series,
#   téléchargements /data/downloads, corbeille /data/.trash.
# Ancien préfixe unique, encore lu si la correspondance ne couvre pas le chemin.
# JELLYFIN_PATH_PREFIX=
# JELLYFIN_POLL_INTERVAL_MIN=30
# Import historique guidé : taille max par fichier SQLite uploadé (octets, défaut 1 Go).
# JELLYFIN_HISTORY_UPLOAD_MAX_BYTES=1073741824

# TMDB_READ_TOKEN=
# Le domaine Wawacity change souvent. Sans URL, aucun scan ne part.
# WAWACITY_BASE_URL=https://exemple.invalid
# WAWACITY_USER_AGENT=
