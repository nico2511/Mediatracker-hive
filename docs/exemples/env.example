# Exemple d'environnement MediaTracker (ne pas committer de secrets réels)
# Aligné sur backend/mediatracker/config.py et .env.example à la racine

SECRET_KEY=changeme-generer-avec-secrets-token-urlsafe-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# SETUP_TOKEN=

PORT=8080
CONFIG_DIR=/config
DATA_DIR=/data
DATABASE_URL=sqlite:////config/app.db
TZ=Europe/Paris
PUID=1000
PGID=100
UMASK=022

# Premier boot seulement — ensuite Réglages UI
ALLDEBRID_API_KEY=
TMDB_READ_TOKEN=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_PATH_MAP=/data/movies=/data/Films;/data/tvshows=/data/Series

MOVIES_DIR=/data/Films
SERIES_DIR=/data/Series
DOWNLOADS_DIR=/data/.mediatracker/downloads
TRASH_DIR=/data/.mediatracker/trash

PUBLIC_URL=https://mediatracker.example.com
FORWARDED_ALLOW_IPS=127.0.0.1
COOKIE_SECURE=auto

DEFAULT_QUALITY=HD
DEFAULT_LANGUAGE=VFF
HOSTER_PREFERENCE=rapidgator,turbobit,uploady,dailyuploads,1fichier
MAX_CONCURRENT_DOWNLOADS=2
SCAN_INTERVAL_MIN=720
DOWNLOAD_SOURCE_ORDER=wawacity,free_telecharger,hive,comet,torrentio

DISK_MIN_FREE_GB=5
BACKUP_KEEP=7
AUTO_DELETE_ENABLED=true
AUTO_DELETE_DAYS=14
TRASH_RETENTION_DAYS=7

# Hive (désactivé par défaut)
HIVE_ENABLED=false
# HIVE_PUBLIC_ADDRESS=https://mtr.example.com
